---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import home from '../data/home.json';
import certs from '../data/certs.json';
import projects from '../data/projects.json';
import arsenal from '../data/arsenal.json';
// Issuer logos, recoloured to currentColor so they adapt to light/dark.
import comptiaLogo from '../../public/media/certs/logos/comptia.svg?raw';
import htbLogo from '../../public/media/certs/logos/hackthebox.svg?raw';
import offsecLogo from '../../public/media/certs/logos/offsec.svg?raw';
import ineLogo from '../../public/media/certs/logos/ine.svg?raw';
const issuerLogos: Record<string, string> = { comptia: comptiaLogo, hackthebox: htbLogo, offsec: offsecLogo, ine: ineLogo };

const posts = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Featured = pinned writeups first, then most recent, max 3.
const pinned = posts.filter((p) => p.data.pinned);
const featured = [...pinned, ...posts.filter((p) => !p.data.pinned)].slice(0, 3);

// Arsenal counts are computed from the writeups, so they stay accurate.
const tagCount = (tag: string) => (tag ? posts.filter((p) => p.data.tags.includes(tag)).length : 0);

const diffClass: Record<string, string> = { instap: 'easy', medium: 'med', hard: 'hard', 'pro-lab': 'hard' };
const diffLabel: Record<string, string> = { instap: 'Instap', medium: 'Medium', hard: 'Hard', 'pro-lab': 'Pro Lab' };
const diffLabelEn: Record<string, string> = { instap: 'Entry', medium: 'Medium', hard: 'Hard', 'pro-lab': 'Pro Lab' };

const h = home.htb;
const xpPct = Math.max(0, Math.min(100, (h.xpCurrent / h.xpMax) * 100)).toFixed(1);

const gh = 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z';
---
<Base title="Said Alhazina" description="Offensive-security writeups en portfolio van Said Alhazina, eJPT, Network+, HTB Skilled.">
  <!-- HERO -->
  <div class="wrap">
    <section class="hero">
      <div class="hero-grid">
        <div>
          <h1>{home.name}</h1>
          <p class="role-line" data-en={home.role_en}>{home.role_nl}</p>
          <p class="lead" data-en={home.lead_en}>{home.lead_nl}</p>
          <div class="hero-actions">
            <a class="btn primary" href="/writeups"><span data-en={home.ctaPrimary_en}>{home.ctaPrimary_nl}</span> <span class="arr">→</span></a>
            <a class="btn" href="#contact" data-en={home.ctaContact_en}>{home.ctaContact_nl}</a>
          </div>
        </div>
        <div class="hero-photo-wrap">
          <div class="hero-portrait">
            <div class="glow"></div>
            <div class="frame"><img src={home.heroImage} alt={home.name} loading="eager" /></div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- HTB PANEL -->
  <div class="wrap">
    <section class="sec" style="padding-top:0">
      <div class="htb-panel">
        <!-- HTB rank card (styled after the HTB profile card) -->
        <div class="htb-card">
          <div class="htb-emblem-lg" aria-hidden="true">
            <svg viewBox="0 0 64 64">
              <defs>
                <linearGradient id="htbRank" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#D479FF" />
                  <stop offset="1" stop-color="#6B2FB5" />
                </linearGradient>
              </defs>
              <path d="M32 1 L61 23 L50 60 L14 60 L3 23 Z" fill="url(#htbRank)" opacity=".28" />
              <path d="M32 7 L54 25 L32 55 L10 25 Z" fill="url(#htbRank)" />
              <path d="M32 7 L54 25 L43 25 L32 16 L21 25 L10 25 Z" fill="#fff" opacity=".22" />
              <path d="M32 20 L45 31 L32 48 L19 31 Z" fill="#160b28" opacity=".55" />
              <path d="M32 26 L39 32 L32 41 L25 32 Z" fill="url(#htbRank)" />
            </svg>
          </div>
          <div class="htb-card-body">
            <div class="htb-toprow">
              <div class="htb-lvl"><span class="lv">Lvl</span><span class="num">{h.level}</span></div>
              <div class="htb-xp">
                <div class="htb-xp-head">
                  <span class="xp-label">Level <span class="xp-chip">XP</span></span>
                  <span class="xp-vals">{`${h.xpCurrent}/${h.xpMax}`}</span>
                </div>
                <div class="htb-bar"><span style={`width:${xpPct}%`}></span></div>
              </div>
            </div>
            <div class="htb-subrow">
              <div class="htb-subcard"><div class="t">{h.rank}</div><div class="s" data-en="HTB Rank">HTB Rank</div></div>
              <div class="htb-subcard grade"><div class="dots">◆◆◆</div><div class="s" data-en="Grade">{`Grade ${h.grade}`}</div></div>
            </div>
          </div>
        </div>
        <!-- Machines pwned, same height as the card -->
        <div class="htb-machines">
          <div class="big">{h.machines}</div>
          <div class="lab" data-en="Machines fully pwned">Machines volledig gepwned</div>
          <div class="hs-sub">user → root / NT AUTHORITY\SYSTEM</div>
        </div>
      </div>
      <div class="htb-caption"><a class="htb-live" href={h.profileUrl} target="_blank" rel="noopener"><span class="lp"></span><span data-en="live profile ↗">live profiel ↗</span></a></div>
    </section>
  </div>

  <hr class="rule" />

  <!-- CERTIFICATIONS -->
  <div class="wrap">
    <section class="sec" id="certifications">
      <div class="sec-head" style="margin-bottom:22px"><div><h2 data-en="Certifications">Certificeringen</h2></div></div>

      <div class="group-head"><div><h3 data-en="Earned">Behaald</h3><p data-en="Completed credentials">Afgeronde credentials</p></div></div>
      <div class="cert-grid" style="margin-bottom:30px">
        {certs.earned.map((c) => (
          <div class="certcard">
            <div class="certimg"><img src={c.image} alt={`${c.title} certificaat`} /><span class="cert-ov" data-en={c.status_en}>{c.status}</span></div>
            <div class="top"><span class="issuer"><span class={`ilogo ilogo-${c.logo}`} set:html={issuerLogos[c.logo]} />{c.issuer}</span></div>
            <div class="body">
              <h4>{c.title}</h4>
              <div class="cmeta"><span data-en={c.date_en}>{c.date}</span></div>
              <p class="desc" data-en={c.desc_en}>{c.desc}</p>
              <div class="cid" data-en={c.credential_en}>{c.credential}</div>
              <div class="acts">
                <a class="verify" href={c.verifyUrl} target="_blank" rel="noopener" data-en="Verify ↗">Verifieer ↗</a>
                <a class="cdetails" href={c.cert} target="_blank" rel="noopener" data-en="Certificate ↗">Certificaat ↗</a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="group-head"><div><h3 data-en="In progress & next">Bezig &amp; volgende</h3><p data-en="What I'm actively working on">Waar ik nu actief aan werk</p></div></div>
      <div class="cert-grid">
        {certs.pursuing.map((c) => (
          <div class="certcard">
            <div class="top"><span class="issuer"><span class={`ilogo ilogo-${c.logo}`} set:html={issuerLogos[c.logo]} />{c.issuer}</span><span class="badge-prog" data-en={c.badgeLabel_en}>{c.badgeLabel}</span></div>
            <div class="body">
              <h4>{c.title}</h4>
              <div class="cmeta"><span data-en={c.meta_en}>{c.meta}</span></div>
              <p class="desc" data-en={c.desc_en}>{c.desc}</p>
              {c.progress > 0 && (
                <>
                  <div class="cert-prog"><span style={`width:${c.progress}%`}></span></div>
                  <div class="cert-prog-lab" data-en={`~${c.progress}% · studying`}>{`~${c.progress}% · studerend`}</div>
                </>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>

  <hr class="rule" />

  <!-- ARSENAL -->
  <div class="wrap">
    <section class="sec">
      <div class="sec-head">
        <div id="arsenal"><h2>Arsenal</h2></div>
        <p data-en="Click a tool to see the writeups where I use it. I'm backing each skill here with proof over time.">Klik op een tool om de writeups te zien waarin ik 'm gebruik. Gaandeweg vul ik elke skill hier aan met bewijs.</p>
      </div>
      {arsenal.groups.map((grp) => (
        <div class="arsenal-group">
          <div class="gl">{grp.group}</div>
          <div class="arsenal-tags">
            {grp.items.map((it) => (
              it.tag
                ? <a class="atag" href={`/writeups?tag=${it.tag}`}>{it.label} <span class="cnt">{tagCount(it.tag)}</span></a>
                : <span class="atag nolink">{it.label}</span>
            ))}
          </div>
        </div>
      ))}
    </section>
  </div>

  <!-- PROJECTS (verschijnt alleen als er projecten in de CMS staan) -->
  {projects.projects.length > 0 && (
  <>
  <div class="wrap">
    <section class="sec" style="padding-top:0" id="projects">
      <div class="sec-head">
        <div><h2 data-en="Projects & scripts">Projecten &amp; scripts</h2></div>
        <p data-en="Tooling I build during labs and CTFs, open on GitHub.">Tooling die ik tijdens labs en CTF's bouw, open op GitHub.</p>
      </div>
      <div class="proj-grid">
        {projects.projects.map((p) => (
          <article class="proj">
            <div class="ph">
              <span class="nm"><svg viewBox="0 0 16 16"><path d={gh}></path></svg>{p.name}</span>
              <span class="when">{p.when}</span>
            </div>
            <div class="proj-img" style={p.bannerImage ? undefined : `background:${p.bannerGradient}`}>
              {p.bannerImage && <img src={p.bannerImage} alt="" loading="lazy" />}
              {p.bannerWord && <span class="pw">{p.bannerWord}</span>}
            </div>
            <p data-en={p.blurb_en}>{p.blurb}</p>
            <div class="pf">
              <span class="lang"><span class="d" style={`background:${p.langColor}`}></span>{p.lang}</span>
              <a class="ghlink" href={p.github} target="_blank" rel="noopener"><svg viewBox="0 0 16 16"><path d={gh}></path></svg>Bekijk op GitHub</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <hr class="rule" />
  </>
  )}

  <!-- FEATURED WRITEUPS -->
  <div class="wrap">
    <section class="sec">
      <div class="sec-head">
        <div><h2 data-en="Featured writeups">Uitgelichte writeups</h2></div>
        <a class="btn" href="/writeups" data-en="View all writeups">Alle writeups bekijken</a>
      </div>
      <div class="grid3">
        {featured.map((p) => (
          <a class="post lift" href={`/writeups/${p.id}`}>
            <div class="pmeta">
              {p.data.category.slice(0, 1).map((c) => <span class="tagc">{c}</span>)}
              <span class={`diff ${diffClass[p.data.difficulty]}`} data-en={diffLabelEn[p.data.difficulty]}>{diffLabel[p.data.difficulty]}</span>
              <span>{p.data.readingTime}</span>
            </div>
            <h3 data-en={p.data.title_en}>{p.data.title}</h3>
            <p data-en={p.data.description_en}>{p.data.description}</p>
            <span class="more" data-en="Read writeup">Lees writeup</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  <hr class="rule" />

  <!-- ABOUT -->
  <div class="wrap">
    <section class="sec about" id="about">
      <div class="about-grid">
        <div>
          <h2 style="font-size:28px;margin:0 0 14px" data-en={home.aboutHeading_en}>{home.aboutHeading_nl}</h2>
          {home.about_nl.map((para, i) => <p data-en={home.about_en[i]}>{para}</p>)}
          <div class="contact-row" id="contact">
            <span class="mono-field">{home.contact.email}
              <button class="copy" data-copy={home.contact.email} data-en="copy">kopieer</button></span>
            <a class="btn" href={home.contact.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a class="btn" href={home.contact.github} target="_blank" rel="noopener">GitHub ↗</a>
          </div>
        </div>
        <div class="about-portrait">
          <div class="glow"></div>
          <div class="frame"><img src={home.aboutImage} alt={home.name} /></div>
          <div class="reticle"><span class="bk tl"></span><span class="bk tr"></span><span class="bk bl"></span><span class="bk brr"></span></div>
        </div>
      </div>
    </section>
  </div>

</Base>
