---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

// Categories are built from the posts themselves: pick a category in the CMS
// and it becomes a filter here automatically.
const catMap = new Map<string, number>();
for (const p of posts) for (const c of p.data.category) catMap.set(c, (catMap.get(c) || 0) + 1);
const cats = [
  { slug: 'all', label: 'Alle writeups', label_en: 'All writeups', n: posts.length },
  ...[...catMap.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .map(([label, n]) => ({ slug: slugify(label), label, label_en: label, n })),
];

// A card matches on BOTH its category slugs and its tool tags, so the sidebar
// (categories) and the arsenal links on the home page (tool tags) both work.
const cardTags = (p: (typeof posts)[number]) =>
  [...p.data.category.map(slugify), ...p.data.tags].join(' ');

const diffClass: Record<string, string> = { instap: 'easy', medium: 'med', hard: 'hard', 'pro-lab': 'hard' };
const diffLabel: Record<string, string> = { instap: 'Instap', medium: 'Medium', hard: 'Hard', 'pro-lab': 'Pro Lab' };
const diffLabelEn: Record<string, string> = { instap: 'Entry', medium: 'Medium', hard: 'Hard', 'pro-lab': 'Pro Lab' };
const fmtD = (d: Date) => d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'short', year: 'numeric' });
const fmtDEn = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Writeups · Said Alhazina" description="Offensive-security writeups, stap voor stap uitgelegd.">
  <div class="wrap">
    <div class="docs">
      <aside class="docs-side">
        <div class="ds-head">Notes</div>
        <nav class="docs-nav" id="docsNav">
          {cats.map((c) => (
            <a data-f={c.slug} class={c.slug === 'all' ? 'active' : ''}><span class="lbl" data-en={c.label_en}>{c.label}</span> <span>{c.n}</span></a>
          ))}
        </nav>
      </aside>
      <div class="docs-main">
        <h1 style="font-size:clamp(28px,4.5vw,42px);font-weight:700">Writeups</h1>
        <p class="art-sub" data-en="Everything I learn, explained step by step so you get it too. Pick a category or browse the recent notes.">Alles wat ik leer, stap voor stap uitgelegd zodat jij het ook snapt. Kies een categorie of blader door de recente notes.</p>
        <nav class="docs-filter-mobile" id="docsNavMobile" aria-label="Categorieën / categories">
          {cats.map((c) => (
            <a data-f={c.slug} class={c.slug === 'all' ? 'active' : ''}><span class="lbl" data-en={c.label_en}>{c.label}</span> <span>{c.n}</span></a>
          ))}
        </nav>
        <div class="active-filter" id="activeFilter">
          <span><span data-en="Filtered on">Gefilterd op</span> <b id="afLabel"></b></span>
          <span class="x" id="afClear" data-en="clear ✕">wis ✕</span>
        </div>
        <h2 class="recent-h" data-en="All writeups">Alle writeups</h2>
        <div class="post-list" id="postList">
          {posts.map((p) => (
            <a class="post" href={`/writeups/${p.id}`} data-tags={cardTags(p)}>
              <div class="pmeta">
                {p.data.category.slice(0, 2).map((c) => <span class="tagc">{c}</span>)}
                <span class={`diff ${diffClass[p.data.difficulty]}`} data-en={diffLabelEn[p.data.difficulty]}>{diffLabel[p.data.difficulty]}</span>
                <span>{p.data.readingTime}</span>
                <span data-en={`· ${fmtDEn(p.data.date)}`}>· {fmtD(p.data.date)}</span>
              </div>
              <h3 data-en={p.data.title_en}>{p.data.title}</h3>
              <p data-en={p.data.description_en}>{p.data.description}</p>
              <span class="more" data-en="Read writeup">Lees writeup</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var afEl = document.getElementById('activeFilter'), afLabel = document.getElementById('afLabel');
      function labelOf(el) { return (el.childNodes[0] ? el.childNodes[0].textContent.trim() : el.dataset.f); }
      function applyFilter(tag, label) {
        document.querySelectorAll('#postList .post').forEach(function (p) {
          var tags = (p.dataset.tags || '').split(' ');
          p.hidden = !(tag === 'all' || tags.indexOf(tag) > -1);
        });
        document.querySelectorAll('#docsNav [data-f], #docsNavMobile [data-f]').forEach(function (c) { c.classList.toggle('active', c.dataset.f === tag); });
        if (afEl) {
          if (tag === 'all') { afEl.classList.remove('on'); }
          else { afLabel.textContent = label || tag; afEl.classList.add('on'); }
        }
      }
      // One handler for both the sidebar (desktop) and the chip row (mobile).
      ['docsNav', 'docsNavMobile'].forEach(function (id) {
        var nav = document.getElementById(id);
        if (!nav) return;
        nav.addEventListener('click', function (e) {
          var el = e.target.closest('[data-f]'); if (!el) return; e.preventDefault();
          applyFilter(el.dataset.f, labelOf(el));
          history.replaceState(null, '', el.dataset.f === 'all' ? location.pathname : location.pathname + '?tag=' + el.dataset.f);
        });
      });
      var afClear = document.getElementById('afClear');
      if (afClear) afClear.addEventListener('click', function () { applyFilter('all'); history.replaceState(null, '', location.pathname); });
      var t = new URLSearchParams(location.search).get('tag');
      if (t) applyFilter(t, t);
    })();
  </script>
</Base>
