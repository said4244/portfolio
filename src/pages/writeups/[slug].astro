---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writeups', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = d.date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'short', year: 'numeric' });
const fmtEn = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title={`${d.title} · Said Alhazina`} description={d.description} type="article">
  <div class="read">
    <div class="art-head">
      <a class="backlink" href="/writeups" data-en="← Back to writeups">← Terug naar writeups</a>
      <div class="art-tags">
        {d.category.map((c) => <span class="tagc">{c}</span>)}
      </div>
      <h1 data-en={d.title_en}>{d.title}</h1>
      <p class="art-sub" data-en={d.description_en}>{d.description}</p>
      <div class="art-meta">
        <span data-en={fmtEn}>{fmt}</span>
        <span><b>{d.readingTime}</b> <span data-en="read">lezen</span></span>
        <span><span data-en="By">Door</span> <b>Said Alhazina</b></span>
      </div>
    </div>
    <div class="art-body">
      <Content />
    </div>
    <hr class="rule" style="margin:30px 0" />
    <p style="font-family:var(--font-mono);font-size:13px;color:var(--muted)"><span data-en="Questions or found a mistake? Email">Vragen of een fout gevonden? Mail</span> <b style="color:var(--fg)">said444b@gmail.com</b><span data-en=", corrections make the next writeup better.">, correcties maken de volgende writeup beter.</span></p>
  </div>
</Base>
